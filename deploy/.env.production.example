# Copy to `.env` on the server (chmod 600). Never commit the real file.
DOMAIN=cynthia.example.com
# The images are NOT set here: deploy.sh receives them pinned by digest (ghcr.io/OWNER/cynthia-rails@sha256:...)
# and keeps the running release in .deploy/current. Manual deploy/rollback: ./deploy.sh $(cat .deploy/previous)

POSTGRES_PASSWORD=               # openssl rand -hex 24
RAILS_MASTER_KEY=                # rails-app/config/master.key
INTERNAL_API_TOKEN=              # openssl rand -hex 32 (shared by Rails and the WhatsApp service)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                  # openssl rand -hex 16

# Optional: Datadog (ADR-012, RUNBOOK §8). Both lines on = agent running and the apps sending traces.
# COMPOSE_PROFILES=datadog
# DD_TRACE_ENABLED=true
DD_API_KEY=                      # Organization Settings → API Keys
DD_SITE=datadoghq.com            # datadoghq.com, us5.datadoghq.com, datadoghq.eu...
DD_LOGS_ENABLED=false            # container logs to Datadog: only after checking they carry no message content

# Optional: where backup.sh copies the backups (an rclone remote, preferably an encrypted one).
BACKUP_REMOTE=
