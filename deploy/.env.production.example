# Copy to `.env` on the server (chmod 600). Never commit the real file.
DOMAIN=cynthia.example.com
# The registry images (set by the pipeline on the server, shown here for a manual deploy).
IMAGE_RAILS=ghcr.io/OWNER/cynthia-rails
IMAGE_WA=ghcr.io/OWNER/cynthia-wa

POSTGRES_PASSWORD=               # openssl rand -hex 24
RAILS_MASTER_KEY=                # rails-app/config/master.key
INTERNAL_API_TOKEN=              # openssl rand -hex 32 (shared by Rails and the WhatsApp service)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                  # openssl rand -hex 16

# Optional: where backup.sh copies the backups (an rclone remote, preferably an encrypted one).
BACKUP_REMOTE=
