# TLS is automatic (Let's Encrypt). With DOMAIN=localhost, Caddy uses its own local CA (for local tests).
{$DOMAIN} {
	encode zstd gzip

	# Access log (JSON, stdout -> docker logs) for monitor.sh: 5xx rate and p99 come from `status` and `duration`.
	# No PII beyond what diagnosis needs: request/response headers dropped, IP cut to /16, query string dropped.
	log {
		output stdout
		format filter {
			request>headers delete
			resp_headers delete
			request>remote_ip ip_mask 16 32
			request>client_ip ip_mask 16 32
			request>uri regexp \?.* ""
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# /assets/* tem digest no nome (Propshaft): o conteúdo nunca muda, o navegador não precisa revalidar (RNF-02).
	# ">" = aplica depois da resposta do Rails, substituindo o Cache-Control dele (que não tem immutable).
	@assets path /assets/*
	header @assets >Cache-Control "public, max-age=31536000, immutable"

	# TM-26: o Rails lê só o X-Forwarded-For que o Caddy reescreve; o Forwarded do cliente não passa (2ª camada,
	# a 1ª é config/initializers/forwarded_headers.rb).
	reverse_proxy rails:80 {
		header_up -Forwarded
	}
}
