# TLS is automatic (Let's Encrypt). With DOMAIN=localhost, Caddy uses its own local CA (for local tests).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy rails:80
}
