<%# rails-app/app/views/groups/show.html.erb %>
<% content_for :title, @group.name %>

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
  <h1 class="text-2xl font-semibold text-wa-text"><%= @group.name %></h1>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <%= link_to "Voltar", groups_path, class: "text-sm text-gray-600 hover:underline" %>
    <% schedules_warning = @group.schedules.any? ? " Os #{@group.schedules.count} agendamentos deste grupo também serão apagados." : "" %>
    <%= button_to "Remover da lista", group_path(@group), method: :delete,
          form: { data: { turbo_confirm: "Remover #{@group.name} do painel? Ele volta na próxima sincronização se você ainda for membro.#{schedules_warning}" } },
          class: "text-sm text-red-600 hover:underline cursor-pointer" %>
    <%= button_to "Sair do grupo", leave_group_path(@group), method: :post,
          form: { data: { turbo_confirm: "Sair de #{@group.name} no WhatsApp? Não dá para desfazer pelo painel.#{schedules_warning}" } },
          class: "text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-full px-4 py-2 cursor-pointer" %>
  </div>
</div>

<section class="bg-white rounded-lg shadow-sm p-4 mb-6">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-wa-muted mb-3">Regras do grupo</h2>

  <% if @attendance_rule %>
    <%= render "group_rules/attendance", rule: @attendance_rule, group: @group %>
  <% else %>
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="font-medium">Lista de presença</p>
        <p class="text-xs text-wa-muted">Membros mensais/avulsos/espera, confirmação por reação ✅/❌ e listas automáticas.</p>
      </div>
      <%= button_to "Ativar", group_rules_path(@group), params: { kind: "attendance" }, method: :post, class: "btn-wa text-sm" %>
    </div>
  <% end %>
</section>

<p class="text-xs text-wa-muted mb-4">
  Use estes nomes ou números com <code class="font-mono">@{{nome}}</code> ou
  <code class="font-mono">@{{numero}}</code> no corpo de um template para mencionar
  o participante ao enviar para este grupo, ou <code class="font-mono">@{{todos}}</code> para notificar todos.
</p>
<% if @round %>
  <p class="mb-4 text-sm">
    <strong>Lista de presença de <%= @round.sent_at.in_time_zone(@round.schedule.timezone).strftime("%d/%m %H:%M") %>:</strong>
    <% fixed_keys = Attendance.fixed_keys(@attendance_rule) %>
    <%= @statuses.values.count("confirmed") %> confirmado(s),
    <%= @statuses.values.count("declined") %> cancelado(s),
    <%= @participants.count { |participant| fixed_keys.include?(participant.role) && !@statuses.key?(participant.id) } %> fixo(s) sem resposta.
  </p>
<% end %>

<%= form_with url: group_path(@group), method: :patch do %>
  <table class="table-cards w-full text-sm bg-white rounded-lg shadow-sm overflow-hidden">
    <thead class="bg-wa-panel text-wa-muted text-xs uppercase tracking-wide">
      <tr class="text-left">
        <th class="py-2 px-3">Nome</th>
        <th class="py-2 px-3">Número</th>
        <% if @attendance_rule %>
          <th class="py-2 px-3">Categoria</th>
          <th class="py-2 px-3">Nome na lista</th>
          <th class="py-2 px-3">Presença</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @participants.each do |participant| %>
        <tr class="border-t border-gray-100 hover:bg-wa-panel/60">
          <td data-label="Nome" class="py-2 px-3"><%= participant.name.presence || "—" %></td>
          <td data-label="Número" class="py-2 px-3 font-mono text-xs"><%= participant.phone_number %></td>
          <% if @attendance_rule %>
            <td data-label="Categoria" class="py-2 px-3">
              <%= select_tag "participants[#{participant.id}][role]",
                    options_for_select(@attendance_settings["categories"].map { |category| [ category["name"], category["key"] ] }, participant.role),
                    include_blank: "—", class: "rounded border-gray-300 text-sm" %>
            </td>
            <td data-label="Nome na lista" class="py-2 px-3">
              <%= text_field_tag "participants[#{participant.id}][display_name]", participant.display_name,
                    placeholder: participant.name, class: "rounded border-gray-300 text-sm w-full" %>
            </td>
            <td data-label="Presença" class="py-2 px-3 text-center"><%= Attendance.mark(@attendance_settings, @statuses[participant.id]) if @statuses.key?(participant.id) %></td>
          <% end %>
        </tr>
      <% end %>
      <% if @participants.empty? %>
        <tr><td colspan="<%= @attendance_rule ? 5 : 2 %>" class="py-4 px-3 text-center text-wa-muted">Nenhum participante sincronizado ainda.</td></tr>
      <% end %>
    </tbody>
  </table>

  <% if @attendance_rule && @participants.any? %>
    <%= submit_tag "Salvar membros", class: "btn-wa mt-4" %>
  <% end %>
<% end %>
