<% content_for :title, "Grupos" %>

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
  <h1 class="text-2xl font-semibold text-wa-text">Grupos</h1>
  <%= button_to "Sincronizar agora", sync_groups_path, method: :post,
        class: "btn-wa" %>
</div>

<%= form_with url: destroy_selected_groups_path, data: { controller: "select-all" } do %>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-3 min-h-9">
    <span data-select-all-target="count" class="text-sm text-wa-muted"></span>
    <button type="submit" formaction="<%= leave_selected_groups_path %>" data-select-all-target="action"
            data-turbo-confirm="Sair dos grupos selecionados no WhatsApp? Os agendamentos deles também serão apagados."
            class="text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-full px-4 py-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
      Sair dos selecionados
    </button>
    <button type="submit" data-select-all-target="action"
            data-turbo-confirm="Remover os grupos selecionados do painel? Os agendamentos deles também serão apagados."
            class="text-sm text-red-600 hover:underline cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed disabled:no-underline">
      Remover selecionados da lista
    </button>
  </div>

  <table class="table-cards w-full text-sm bg-white rounded-lg shadow-sm overflow-hidden">
    <thead class="bg-wa-panel text-wa-muted text-xs uppercase tracking-wide">
      <tr class="text-left">
        <th class="py-2 px-3 w-8">
          <input type="checkbox" aria-label="Selecionar todos" data-select-all-target="all" data-action="select-all#toggleAll">
        </th>
        <th class="py-2 px-3">Nome</th>
        <th class="py-2 px-3">JID</th>
        <th class="py-2 px-3">Participantes</th>
        <th class="py-2 px-3">Sincronizado em</th>
      </tr>
    </thead>
    <tbody>
      <% @groups.each do |group| %>
        <tr class="border-t border-gray-100 hover:bg-wa-panel/60">
          <td class="py-2 px-3">
            <%= check_box_tag "ids[]", group.id, false, id: "group_#{group.id}", aria: { label: "Selecionar #{group.name}" },
                  data: { select_all_target: "item", action: "select-all#refresh" } %>
          </td>
          <td data-label="Nome" class="py-2 px-3"><%= link_to group.name, group_path(group), class: "text-wa-teal font-medium hover:underline" %></td>
          <td data-label="JID" class="py-2 px-3 font-mono text-xs"><%= group.jid %></td>
          <td data-label="Participantes" class="py-2 px-3"><%= group.participants_count %></td>
          <td data-label="Sincronizado" class="py-2 px-3"><%= group.synced_at&.strftime("%d/%m/%Y %H:%M") %></td>
        </tr>
      <% end %>
      <% if @groups.empty? %>
        <tr><td colspan="5" class="py-4 px-3 text-center text-wa-muted">Nenhum grupo sincronizado ainda.</td></tr>
      <% end %>
    </tbody>
  </table>
<% end %>
