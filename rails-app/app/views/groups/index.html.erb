<% content_for :title, "Grupos" %>

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
  <h1 class="text-2xl font-semibold text-wa-text">Grupos</h1>
  <%= button_to "Sincronizar agora", sync_groups_path, method: :post,
        class: "btn-wa" %>
</div>

<%= form_with url: destroy_selected_groups_path, data: { controller: "select-all" } do %>
  <div data-select-all-target="bar" hidden
       class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-3 rounded-lg bg-white shadow-sm border border-red-100 px-4 py-2">
    <span data-select-all-target="count" class="text-sm font-medium"></span>
    <button type="submit" formaction="<%= leave_selected_groups_path %>"
            data-turbo-confirm="Sair dos grupos selecionados no WhatsApp? Listas, templates e fluxos deles também serão apagados."
            class="text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-full px-4 py-1.5 cursor-pointer">
      Sair dos grupos no WhatsApp
    </button>
    <button type="submit"
            data-turbo-confirm="Remover os grupos selecionados do painel? Listas, templates e fluxos deles também serão apagados."
            class="text-sm text-red-600 hover:underline cursor-pointer">
      Remover do painel
    </button>
  </div>

  <table class="table-cards w-full text-sm bg-white rounded-lg shadow-sm overflow-hidden">
    <thead class="bg-wa-panel text-wa-muted text-xs uppercase tracking-wide">
      <tr class="text-left">
        <th class="py-2 px-3 w-8">
          <input type="checkbox" aria-label="Selecionar todos" data-select-all-target="all" data-action="select-all#toggleAll">
        </th>
        <th class="py-2 px-3">Grupo</th>
        <th class="py-2 px-3">Automação</th>
        <th class="py-2 px-3">Sincronizado</th>
      </tr>
    </thead>
    <tbody>
      <% @groups.each do |group| %>
        <tr class="border-t border-gray-100 hover:bg-wa-panel/60">
          <td class="py-2 px-3">
            <%= check_box_tag "ids[]", group.id, false, id: "group_#{group.id}", aria: { label: "Selecionar #{group.name}" },
                  data: { select_all_target: "item", action: "select-all#refresh" } %>
          </td>
          <td data-label="Grupo" class="py-2 px-3">
            <%= link_to group.name, group_path(group), class: "text-wa-teal font-medium hover:underline" %>
            <span class="block text-xs text-wa-muted"><%= pluralize(group.participants_count.to_i, "membro", plural: "membros") %></span>
          </td>
          <td data-label="Automação" class="py-2 px-3">
            <div class="flex flex-wrap gap-1 text-xs">
              <% if group.flows_count.positive? %>
                <span class="rounded-full bg-wa-bubble text-wa-teal px-2 py-0.5"><%= pluralize(group.flows_count, "fluxo", plural: "fluxos") %></span>
              <% end %>
              <% group.group_rules.each do |rule| %>
                <span class="rounded-full bg-wa-panel text-wa-text px-2 py-0.5"><%= rule.name %></span>
              <% end %>
              <% if group.flows_count.zero? && group.group_rules.empty? %>
                <span class="text-wa-muted">—</span>
              <% end %>
            </div>
          </td>
          <td data-label="Sincronizado" class="py-2 px-3 text-xs text-wa-muted"><%= group.synced_at&.strftime("%d/%m %H:%M") || "—" %></td>
        </tr>
      <% end %>
      <% if @groups.empty? %>
        <tr><td colspan="4" class="py-4 px-3 text-center text-wa-muted">Nenhum grupo sincronizado ainda.</td></tr>
      <% end %>
    </tbody>
  </table>
<% end %>
