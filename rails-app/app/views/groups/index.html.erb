<% content_for :title, "Grupos" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Grupos</h1>
  <%= button_to "Sincronizar agora", sync_groups_path, method: :post,
        class: "bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800" %>
</div>

<table class="w-full text-sm border-collapse bg-white shadow rounded overflow-hidden">
  <thead class="bg-gray-100">
    <tr class="text-left">
      <th class="py-2 px-3">Nome</th>
      <th class="py-2 px-3">JID</th>
      <th class="py-2 px-3">Participantes</th>
      <th class="py-2 px-3">Sincronizado em</th>
    </tr>
  </thead>
  <tbody>
    <% @groups.each do |group| %>
      <tr class="border-t">
        <td class="py-2 px-3"><%= link_to group.name, group_path(group), class: "text-blue-700 hover:underline" %></td>
        <td class="py-2 px-3 font-mono text-xs"><%= group.jid %></td>
        <td class="py-2 px-3"><%= group.participants_count %></td>
        <td class="py-2 px-3"><%= group.synced_at&.strftime("%d/%m/%Y %H:%M") %></td>
      </tr>
    <% end %>
    <% if @groups.empty? %>
      <tr><td colspan="4" class="py-4 px-3 text-center text-gray-500">Nenhum grupo sincronizado ainda.</td></tr>
    <% end %>
  </tbody>
</table>
