<%= form_with model: @template, class: "space-y-4 max-w-xl" do |f| %>
  <% if @template.errors.any? %>
    <div class="bg-red-100 text-red-800 rounded px-4 py-2 text-sm">
      <ul class="list-disc list-inside">
        <% @template.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded border-gray-300" %>
  </div>

  <div data-controller="template-preview">
    <%= f.label :body, "Corpo (use {{variavel}} para placeholders)", class: "block text-sm font-medium" %>
    <%= f.text_area :body, rows: 6,
          data: { template_preview_target: "body", action: "input->template-preview#update" },
          class: "mt-1 block w-full rounded border-gray-300 font-mono text-sm" %>
    <p class="mt-1 text-xs text-gray-500">
      Variáveis detectadas: <span data-template-preview-target="output" class="font-mono"></span>
    </p>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active %>
    <%= f.label :active, class: "text-sm" %>
  </div>

  <%= f.submit class: "bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800 cursor-pointer" %>
<% end %>
