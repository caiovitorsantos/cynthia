<%= form_with model: @template, class: "space-y-4 max-w-xl" do |f| %>
  <% if @template.errors.any? %>
    <div class="bg-red-100 text-red-800 rounded px-4 py-2 text-sm">
      <ul class="list-disc list-inside">
        <% @template.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded border-gray-300" %>
  </div>

  <div data-controller="template-preview">
    <%= f.label :body, "Corpo (use {{variavel}} para placeholders)", class: "block text-sm font-medium" %>
    <%= f.text_area :body, rows: 6,
          data: { template_preview_target: "body", action: "input->template-preview#update" },
          class: "mt-1 block w-full rounded border-gray-300 font-mono text-sm" %>
    <p class="mt-1 text-xs text-wa-muted">
      Variáveis detectadas: <span data-template-preview-target="output" class="font-mono"></span>
    </p>
    <p class="mt-1 text-xs text-wa-muted">
      Automáticas (preenchidas no envio): <code class="font-mono">{{data}}</code> (dd/mm),
      <code class="font-mono">{{mes}}</code>, <code class="font-mono">{{mes_num}}</code>,
      <code class="font-mono">{{mes_anterior}}</code>, <code class="font-mono">{{lista_mensais}}</code>,
      <code class="font-mono">{{mencoes_mensais}}</code>, <code class="font-mono">{{lista_espera}}</code>.
    </p>
    <p class="mt-1 text-xs text-wa-muted">
      Da lista de presença atual do grupo: <code class="font-mono">{{presenca_mensais}}</code> (mensais com ✅/❌),
      <code class="font-mono">{{presenca_avulsos}}</code> (não-mensais que confirmaram),
      <code class="font-mono">{{mencoes_pendentes}}</code> (marca mensais que ainda não responderam).
    </p>

    <div class="mt-4 bg-wa-chat rounded-lg p-4">
      <p class="text-xs text-wa-muted mb-2">Prévia</p>
      <div data-template-preview-target="bubble"
           class="w-fit max-w-full bg-wa-bubble rounded-lg rounded-tr-none px-3 py-2 shadow-sm text-sm whitespace-pre-wrap break-words"></div>
    </div>
  </div>

  <div class="flex items-start gap-2">
    <%= f.check_box :attendance, class: "mt-1" %>
    <div>
      <%= f.label :attendance, "Lista de presença", class: "text-sm" %>
      <p class="text-xs text-wa-muted">Cada envio abre uma rodada: reações ✅/❌ (ou respostas citando a mensagem) contam como confirmação/cancelamento.</p>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active %>
    <%= f.label :active, class: "text-sm" %>
  </div>

  <%= f.submit class: "btn-wa" %>
<% end %>
