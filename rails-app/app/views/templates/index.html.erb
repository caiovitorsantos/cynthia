<% content_for :title, "Templates" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold text-wa-text">Templates</h1>
  <%= link_to "Novo template", new_template_path, class: "btn-wa" %>
</div>

<table class="w-full text-sm bg-white rounded-lg shadow-sm overflow-hidden">
  <thead class="bg-wa-panel text-wa-muted text-xs uppercase tracking-wide">
    <tr class="text-left">
      <th class="py-2 px-3">Nome</th>
      <th class="py-2 px-3">Variáveis</th>
      <th class="py-2 px-3">Ativo</th>
      <th class="py-2 px-3"></th>
    </tr>
  </thead>
  <tbody>
    <% @templates.each do |template| %>
      <tr class="border-t border-gray-100 hover:bg-wa-panel/60">
        <td class="py-2 px-3"><%= template.name %></td>
        <td class="py-2 px-3 font-mono text-xs"><%= template.variable_names.join(", ").presence || "—" %></td>
        <td class="py-2 px-3"><%= template.active? ? "Sim" : "Não" %></td>
        <td class="py-2 px-3 text-right space-x-3">
          <%= link_to "Editar", edit_template_path(template), class: "text-wa-teal hover:underline" %>
          <%= button_to "Remover", template_path(template), method: :delete,
                form: { data: { turbo_confirm: "Remover este template?" }, class: "inline" },
                class: "text-red-600 hover:underline bg-transparent p-0" %>
        </td>
      </tr>
    <% end %>
    <% if @templates.empty? %>
      <tr><td colspan="4" class="py-4 px-3 text-center text-wa-muted">Nenhum template cadastrado.</td></tr>
    <% end %>
  </tbody>
</table>
