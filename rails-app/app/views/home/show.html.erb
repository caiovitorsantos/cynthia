<% content_for :title, t(".page_title") %>
<% bubble = "rounded-lg px-3 py-2 text-sm shadow-sm max-w-[85%] whitespace-pre-line" %>

<section class="grid md:grid-cols-2 gap-10 items-center py-6 md:py-12">
  <div class="order-2 md:order-1">
    <p class="text-wa-green font-semibold tracking-wide uppercase text-xs mb-3"><%= t(".kicker") %></p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tight">
      <%= t(".headline_html") %><br>
      <span class="text-wa-muted text-3xl md:text-4xl"><%= t(".subheadline") %></span>
    </h1>
    <p class="mt-5 text-lg text-wa-muted max-w-xl"><%= t(".intro") %></p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <%= link_to t(".cta"), login_path, class: "btn-wa text-base px-6 py-3" %>
      <a href="#como-funciona" class="text-wa-green hover:underline"><%= t(".how_link") %></a>
    </div>
  </div>
  <div class="order-1 md:order-2 flex justify-center">
    <%# RNF-02: WebP (25 KB) com PNG de reserva; é o LCP da página, então carrega com prioridade alta. %>
    <picture>
      <source srcset="<%= image_path "cynthia.webp" %>" type="image/webp">
      <%= image_tag "cynthia.png", alt: t(".art_alt"), width: 534, height: 486, fetchpriority: "high",
            class: "w-[420px] max-w-full h-auto drop-shadow-[0_0_40px_rgba(0,168,132,0.25)]" %>
    </picture>
  </div>
</section>

<section class="py-10" aria-labelledby="no-grupo">
  <h2 id="no-grupo" class="text-2xl font-semibold mb-6 text-center"><%= t(".chat.title") %></h2>
  <div class="max-w-md mx-auto rounded-xl overflow-hidden border border-wa-line shadow-lg">
    <div class="bg-wa-header px-4 py-3 flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-wa-raised flex items-center justify-center">🏐</div>
      <div>
        <p class="font-medium text-sm"><%= t(".chat.group") %></p>
        <p class="text-xs text-wa-muted"><%= t(".chat.members") %></p>
      </div>
    </div>
    <div class="bg-wa-chat p-4 space-y-2">
      <div class="flex justify-start"><div class="<%= bubble %> bg-wa-raised"><span class="block text-xs font-medium text-pink-300">Bruno</span><%= t(".chat.list_command") %></div></div>
      <div class="flex justify-start">
        <div class="<%= bubble %> bg-wa-raised"><span class="block text-xs font-medium text-wa-green">Cynth.ia</span><%= t(".chat.list_reply_html") %></div>
      </div>
      <div class="flex justify-start"><div class="<%= bubble %> bg-wa-raised"><span class="block text-xs font-medium text-amber-300">Diego</span><%= t(".chat.wait_command") %></div></div>
      <div class="flex justify-start"><div class="<%= bubble %> bg-wa-raised"><span class="block text-xs font-medium text-wa-green">Cynth.ia</span><%= t(".chat.wait_reply_html") %></div></div>
      <div class="flex justify-end"><div class="<%= bubble %> bg-wa-bubble"><%= t(".chat.thanks") %></div></div>
      <p class="text-center text-xs text-wa-muted pt-1"><%= t(".chat.seen") %></p>
    </div>
  </div>
</section>

<section class="py-10" aria-labelledby="o-que-faz">
  <h2 id="o-que-faz" class="text-2xl font-semibold mb-6 text-center"><%= t(".features.title") %></h2>
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <% { "lists" => "📋", "flows" => "⏰", "attendance" => "✅", "billing" => "💰" }.each do |key, icon| %>
      <div class="bg-wa-surface border border-wa-line rounded-xl p-5">
        <div class="text-2xl mb-3" aria-hidden="true"><%= icon %></div>
        <h3 class="font-semibold mb-1"><%= t(".features.#{key}.title") %></h3>
        <p class="text-sm text-wa-muted"><%= t(".features.#{key}.text") %></p>
      </div>
    <% end %>
  </div>
</section>

<section id="como-funciona" class="py-10 scroll-mt-4" aria-labelledby="como">
  <h2 id="como" class="text-2xl font-semibold mb-6 text-center"><%= t(".how.title") %></h2>
  <ol class="grid md:grid-cols-3 gap-4">
    <% %w[connect organize relax].each_with_index do |key, index| %>
      <li class="bg-wa-surface border border-wa-line rounded-xl p-5">
        <span class="inline-flex w-8 h-8 items-center justify-center rounded-full bg-wa-green text-wa-panel font-bold mb-3"><%= index + 1 %></span>
        <h3 class="font-semibold mb-1"><%= t(".how.#{key}.title") %></h3>
        <p class="text-sm text-wa-muted"><%= t(".how.#{key}.text") %></p>
      </li>
    <% end %>
  </ol>
  <div class="text-center mt-10">
    <%= link_to t(".cta"), login_path, class: "btn-wa text-base px-6 py-3" %>
    <p class="text-xs text-wa-muted mt-4"><%= t(".disclaimer") %></p>
  </div>
</section>
