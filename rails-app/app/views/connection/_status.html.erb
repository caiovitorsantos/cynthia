<div class="space-y-3 text-sm">
  <p>
    <span class="px-2 py-1 rounded <%=
      case @status
      when "connected" then "bg-wa-bubble text-wa-text"
      when "qr_pending" then "bg-yellow-900/40 text-yellow-300"
      else "bg-red-950/50 text-red-300"
      end
    %>">
      <%= { "connected" => "conectado", "qr_pending" => "aguardando QR Code", "disconnected" => "desconectado" }.fetch(@status, "wa-service fora do ar") %>
    </span>
  </p>

  <% if @status == "qr_pending" %>
    <div>
      <p class="mb-2 text-sm text-wa-muted">
        Escaneie com o WhatsApp — use sempre um número secundário/descartável.
      </p>
      <% if @qr.present? %>
        <%= image_tag @qr, alt: "QR Code", class: "w-64 h-64 border" %>
      <% else %>
        <p class="text-sm text-wa-muted">Gerando QR Code...</p>
      <% end %>
    </div>
  <% end %>

  <% if @status == "connected" %>
    <%= button_to "Desconectar este número", logout_connection_path,
          method: :post,
          class: "text-sm text-red-400 hover:underline cursor-pointer",
          data: { turbo_confirm: "Tem certeza? Isso vai desconectar o WhatsApp e exigir um novo QR Code." } %>
  <% end %>

  <% if @status == "disconnected" %>
    <%= button_to "Gerar novo QR Code", logout_connection_path, method: :post, class: "btn-wa" %>
  <% end %>

  <% if @status == "unreachable" %>
    <p class="text-sm text-wa-muted">Não foi possível falar com o wa-service. Verifique se o container está no ar.</p>
  <% end %>
</div>
