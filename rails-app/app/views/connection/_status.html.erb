<div class="space-y-3 text-sm">
  <p>
    <span class="px-2 py-1 rounded <%=
      case @status
      when "connected" then "bg-wa-bubble text-wa-text"
      when "qr_pending" then "bg-yellow-900/40 text-yellow-300"
      else "bg-red-950/50 text-red-300"
      end
    %>">
      <%= t("connection.status.states.#{@status}", default: t("connection.status.states.unreachable")) %>
    </span>
  </p>

  <% if @status == "qr_pending" %>
    <div>
      <p class="mb-2 text-sm text-wa-muted">
        <%= t("connection.status.scan") %>
      </p>
      <% if @qr.present? %>
        <%= image_tag @qr, alt: "QR Code", class: "w-64 h-64 border" %>
      <% else %>
        <p class="text-sm text-wa-muted"><%= t("connection.status.generating") %></p>
      <% end %>
    </div>
  <% end %>

  <% if @status == "connected" %>
    <%= button_to t("connection.status.disconnect"), logout_connection_path,
          method: :post,
          class: "text-sm text-red-400 hover:underline cursor-pointer",
          data: { turbo_confirm: t("connection.status.disconnect_confirm") } %>
  <% end %>

  <% if @status == "disconnected" %>
    <%= button_to t("connection.status.new_qr"), logout_connection_path, method: :post, class: "btn-wa" %>
  <% end %>

  <% if @status == "unreachable" %>
    <p class="text-sm text-wa-muted"><%= t("connection.status.unreachable") %></p>
  <% end %>
</div>
