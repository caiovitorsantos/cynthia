<%# Bloco da regra "Cobrança mensal" na página do grupo. %>
<% settings = Billing.settings(rule) %>
<% charged = lists.select { |list| settings["charged_lists"].include?(list.key) } %>
<% billing_flows = group.flows.select { |flow| flow.active? && flow.steps.any? { |step| step["opens_billing"] == "1" } } %>
<% period = Billing.current_period(rule) %>
<% charges = Billing.current_charges(rule) %>
<% due = Billing.months_due(rule) %>
<% unmatched = Billing.unmatched_names(rule) %>
<% mark = settings["paid_emojis"].split.first %>

<div class="flex items-start justify-between gap-4">
  <div>
    <p class="font-medium"><%= t("group_rules.names.billing") %> <span class="text-xs text-wa-text bg-wa-bubble rounded-full px-2 py-0.5 ml-1"><%= t("group_rules.active") %></span></p>
    <p class="text-xs text-wa-muted"><%= t(".summary") %></p>
  </div>
  <%= button_to t("group_rules.deactivate"), group_rule_path(group, rule), method: :delete,
        form: { data: { turbo_confirm: t(".deactivate_confirm") } },
        class: "text-sm text-red-400 hover:underline cursor-pointer" %>
</div>

<ol class="mt-4 space-y-2 text-sm">
  <li class="flex items-center gap-2">
    <span><%= charged.any? ? "✅" : "⚠️" %></span>
    <span><strong><%= t(".charged") %></strong> <%= charged.map(&:name).to_sentence.presence || t("common.none_f") %></span>
  </li>
  <li class="flex items-center gap-2">
    <span><%= billing_flows.any? ? "✅" : "⚠️" %></span>
    <span><strong><%= t(".billing_flow") %></strong> <%= billing_flows.map(&:name).to_sentence.presence || t("common.none_m") %></span>
    <% if billing_flows.none? %>
      <%= link_to t("group_rules.create_schedule"), new_group_flow_path(group, trigger: "schedule"), class: "text-wa-teal hover:underline" %>
      <span class="text-wa-muted"><%= t(".billing_flow_hint") %></span>
    <% end %>
  </li>
</ol>

<% if unmatched.any? %>
  <p class="mt-3 text-sm bg-yellow-950/40 border border-yellow-800/60 rounded px-3 py-2">
    ⚠️ <strong><%= t(".unmatched", mark: mark) %></strong> <%= unmatched.to_sentence %>. <%= t(".unmatched_hint") %>
  </p>
<% end %>

<% if period %>
  <% month = Date.strptime(period, "%Y-%m") %>
  <p class="mt-4 text-sm font-medium"><%= t(".period", month: t("date.month_names")[month.month], year: month.year) %>
    <span class="font-normal text-wa-muted"><%= t(".paid_count", paid: charges.count(&:paid?), total: charges.size) %></span></p>
  <table class="table-cards w-full text-sm mt-2">
    <tbody>
      <% charges.each do |charge| %>
        <tr class="border-t border-wa-line">
          <td data-label="<%= t(".who") %>" class="py-1.5 pr-3"><%= charge.label %></td>
          <td data-label="<%= t(".kind") %>" class="py-1.5 pr-3 text-wa-muted text-xs">
            <%= charge.kind == "mensal" ? t(".monthly") : t(".daily", date: l(charge.date, format: :day_month)) %>
            <% if charge.kind == "mensal" && due[charge.group_participant_id].to_i > 1 %><span class="text-red-400">· <%= t(".months_due", count: due[charge.group_participant_id]) %></span><% end %>
          </td>
          <td data-label="<%= t(".paid") %>" class="py-1.5 pr-3"><%= charge.paid? ? "#{mark} #{l(charge.paid_at.to_date, format: :day_month)}" : t(".pending") %></td>
          <td class="py-1.5 sm:text-right">
            <%= button_to (charge.paid? ? t(".undo") : t(".mark_paid")), group_charge_path(group, charge), method: :patch,
                  class: "#{charge.paid? ? 'text-wa-muted' : 'text-wa-teal'} hover:underline bg-transparent p-0" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<details class="mt-4 border-t border-wa-line pt-3" <%= "open" if charged.none? %>>
  <summary class="text-sm font-medium text-wa-teal cursor-pointer"><%= t("group_rules.configure") %></summary>

  <%= form_with url: group_rule_path(group, rule), method: :patch, scope: :rule, class: "mt-4 space-y-5 text-sm" do |f| %>
    <fieldset class="min-w-0">
      <legend class="font-medium"><%= t(".charged_title") %></legend>
      <%= hidden_field_tag "rule[charged_lists][]", "", id: nil %>
      <div class="flex flex-wrap gap-x-4 gap-y-1 mt-1">
        <% lists.each do |list| %>
          <label class="flex items-center gap-1">
            <%= check_box_tag "rule[charged_lists][]", list.key, settings["charged_lists"].include?(list.key), id: nil %>
            <%= list.name %>
          </label>
        <% end %>
      </div>
      <p class="text-xs text-wa-muted mt-1"><%= t(".charged_help") %></p>
    </fieldset>
    <div>
      <%= f.label :paid_emojis, t(".paid_emojis"), class: "block text-xs text-wa-muted" %>
      <%= f.text_field :paid_emojis, value: settings["paid_emojis"], class: "w-full sm:w-64" %>
    </div>
    <%= f.submit t("group_rules.save"), class: "btn-wa" %>
  <% end %>
</details>

<details class="mt-3 border-t border-wa-line pt-3">
  <summary class="text-sm font-medium text-wa-teal cursor-pointer"><%= t("group_rules.variables") %></summary>
  <table class="mt-3 text-xs">
    <% %w[cobranca_mensais cobranca_avulsos pendentes_pagamento].each do |variable| %>
      <tr><td class="font-mono pr-4 py-0.5">{{<%= variable %>}}</td><td class="text-wa-muted"><%= t(".vars.#{variable}", mark: mark) %></td></tr>
    <% end %>
  </table>
  <p class="mt-2 text-xs text-wa-muted"><%= t(".vars_help", mark: mark) %></p>
</details>
