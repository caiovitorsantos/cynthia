<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "WhatsApp Scheduler" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="WhatsApp Scheduler">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-wa-panel text-wa-text min-h-screen">
    <header class="bg-wa-teal text-white shadow">
      <div class="container mx-auto px-4 sm:px-5">
        <div class="flex items-center gap-3 pt-4 <%= logged_in? ? "pb-2" : "pb-4" %>">
          <svg viewBox="0 0 24 24" class="w-7 h-7 fill-current" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 0 1 12 4Zm4 9.6c-.2-.1-1.3-.6-1.5-.7-.2-.1-.4-.1-.5.1l-.7.9c-.1.1-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.7-1.6c-.2-.4-.4-.4-.5-.4h-.4a.8.8 0 0 0-.6.3 2.5 2.5 0 0 0-.8 1.9 4.4 4.4 0 0 0 .9 2.3 10 10 0 0 0 3.9 3.4c1.4.6 2 .7 2.7.6a2.3 2.3 0 0 0 1.5-1.1 1.9 1.9 0 0 0 .1-1.1c0-.1-.2-.2-.4-.2Z"/>
          </svg>
          <span class="text-lg sm:text-xl font-medium truncate">WhatsApp Scheduler</span>
          <% if logged_in? %>
            <%= button_to "Sair", logout_path, method: :delete,
                  class: "text-sm font-medium border border-white/60 rounded-full px-4 py-1 hover:bg-white/10 cursor-pointer",
                  form: { class: "ml-auto" } %>
          <% end %>
        </div>
        <% if logged_in? %>
          <nav class="flex text-sm font-medium uppercase tracking-wide overflow-x-auto no-scrollbar -mx-4 px-2 sm:mx-0 sm:px-0">
            <% [["Conexão", connection_path, "connection"], ["Templates", templates_path, "templates"],
                ["Grupos", groups_path, "groups"], ["Agendamentos", schedules_path, "schedules"],
                ["Logs", logs_path, "logs"]].each do |label, path, controller| %>
              <%= link_to label, path, class: "px-4 py-3 border-b-[3px] whitespace-nowrap #{controller_name == controller ? 'border-white text-white' : 'border-transparent text-white/70 hover:text-white'}" %>
            <% end %>
          </nav>
        <% end %>
      </div>
    </header>

    <main class="container mx-auto mt-6 sm:mt-8 px-4 sm:px-5 pb-16">
      <% if notice.present? %>
        <p class="mb-4 rounded-lg bg-wa-bubble shadow-sm px-4 py-2"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="mb-4 rounded-lg bg-red-100 text-red-800 shadow-sm px-4 py-2"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
