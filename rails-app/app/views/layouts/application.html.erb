<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "WhatsApp Scheduler" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="WhatsApp Scheduler">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <nav class="bg-gray-900 text-white">
      <div class="container mx-auto px-5 py-3 flex items-center gap-6">
        <span class="font-semibold">WhatsApp Scheduler</span>
        <div class="flex gap-4 text-sm">
          <%= link_to "Conexão", connection_path, class: "hover:underline" %>
          <%= link_to "Templates", templates_path, class: "hover:underline" %>
          <%= link_to "Grupos", groups_path, class: "hover:underline" %>
          <%= link_to "Agendamentos", schedules_path, class: "hover:underline" %>
          <%= link_to "Logs", logs_path, class: "hover:underline" %>
        </div>
      </div>
    </nav>

    <main class="container mx-auto mt-8 px-5 pb-16">
      <% if notice.present? %>
        <p class="mb-4 rounded bg-green-100 text-green-800 px-4 py-2"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="mb-4 rounded bg-red-100 text-red-800 px-4 py-2"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
