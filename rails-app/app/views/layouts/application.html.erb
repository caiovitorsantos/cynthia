<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Cynth.ia" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Cynth.ia">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png?v=cynthia-arte" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png?v=cynthia-arte">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-wa-panel text-wa-text min-h-screen">
    <header class="bg-wa-header text-wa-text border-b border-wa-line">
      <div class="container mx-auto px-4 sm:px-5">
        <div class="flex items-center gap-3 pt-4 <%= logged_in? ? "pb-2" : "pb-4" %>">
          <%= link_to (logged_in? ? groups_path : root_path), class: "flex items-center gap-3 min-w-0" do %>
            <%= image_tag "cynthia-face.png", alt: "", class: "w-10 h-10" %>
            <span class="text-lg sm:text-xl font-semibold truncate">Cynth<span class="text-wa-green">.ia</span></span>
          <% end %>
          <% if logged_in? %>
            <div class="ml-auto" data-controller="dialog">
              <button type="button" data-action="dialog#open" aria-haspopup="dialog"
                      class="flex items-center gap-2 text-sm font-medium border border-wa-line rounded-full pl-1.5 pr-3 py-1 hover:bg-wa-raised cursor-pointer">
                <span class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 2c-4 0-8 2-8 5v2h16v-2c0-3-4-5-8-5Z"/></svg>
                </span>
                <%= ENV.fetch("ADMIN_USERNAME", "admin") %>
              </button>
              <%= render "layouts/account" %>
            </div>
          <% elsif controller_name != "sessions" %>
            <%= link_to "Entrar", login_path, class: "ml-auto text-sm font-medium border border-wa-line rounded-full px-4 py-1.5 hover:bg-wa-raised" %>
          <% end %>
        </div>
        <% if logged_in? %>
          <nav class="flex text-sm font-medium uppercase tracking-wide overflow-x-auto no-scrollbar -mx-4 px-2 sm:mx-0 sm:px-0">
            <% [["Grupos", groups_path, %w[groups templates flows]], ["Logs", logs_path, %w[logs]]].each do |label, path, controllers| %>
              <%= link_to label, path, class: "px-4 py-3 border-b-[3px] whitespace-nowrap #{controllers.include?(controller_name) ? 'border-wa-green text-wa-text' : 'border-transparent text-wa-muted hover:text-wa-text'}" %>
            <% end %>
          </nav>
        <% end %>
      </div>
    </header>

    <main class="container mx-auto mt-6 sm:mt-8 px-4 sm:px-5 pb-16">
      <%# Avisos como mensagem da Cynth.ia, no balão do WhatsApp. %>
      <% { notice => "bg-wa-raised", alert => "bg-red-950/60 text-red-200" }.each do |message, bubble| %>
        <% next if message.blank? %>
        <div class="mb-4 flex items-start gap-2" role="status">
          <%= image_tag "cynthia-face.png", alt: "", class: "w-8 h-8 rounded-full bg-wa-raised shrink-0" %>
          <p class="<%= bubble %> rounded-lg rounded-tl-none shadow-sm px-3 py-2 text-sm max-w-xl">
            <span class="block text-xs font-medium text-wa-green">Cynth.ia</span><%= message %>
          </p>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
