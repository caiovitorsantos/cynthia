<%= form_with model: @schedule, class: "space-y-4 max-w-2xl" do |f| %>
  <% if @schedule.errors.any? %>
    <div class="bg-red-100 text-red-800 rounded px-4 py-2 text-sm">
      <ul class="list-disc list-inside">
        <% @schedule.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :template_id, "Template", class: "block text-sm font-medium" %>
    <%= f.collection_select :template_id, ::Template.where(active: true).order(:name), :id, :name,
          { prompt: true }, class: "mt-1 block w-full rounded border-gray-300" %>
  </div>

  <div>
    <%= f.label :whatsapp_group_id, "Grupo", class: "block text-sm font-medium" %>
    <%= f.collection_select :whatsapp_group_id, WhatsappGroup.order(:name), :id, :name,
          { prompt: true }, class: "mt-1 block w-full rounded border-gray-300" %>
  </div>

  <div>
    <%= f.label :variables_json, "Variáveis (JSON)", class: "block text-sm font-medium" %>
    <%= f.text_area :variables_json, rows: 3,
          class: "mt-1 block w-full rounded border-gray-300 font-mono text-sm",
          placeholder: '{"nome": "Caio", "horario": "10h"}' %>
  </div>

  <fieldset class="border rounded-lg p-4 space-y-3 min-w-0">
    <legend class="text-sm font-medium px-1">Recorrente (cron) OU pontual (data) — não os dois</legend>

    <div class="flex flex-wrap gap-2 items-end">
      <div class="flex-1 min-w-40">
        <%= f.label :cron_expression, "Cron", class: "block text-xs text-gray-600" %>
        <%= f.text_field :cron_expression, placeholder: "0 9 * * 1-5",
              class: "mt-1 block w-full rounded border-gray-300 font-mono text-sm" %>
      </div>
      <div class="w-full sm:w-56">
        <%= f.label :timezone, "Timezone", class: "block text-xs text-gray-600" %>
        <%= f.text_field :timezone, class: "mt-1 block w-full rounded border-gray-300 text-sm" %>
      </div>
      <button type="submit" formaction="<%= cron_preview_schedules_path %>" formmethod="get" formnovalidate
              data-turbo-frame="cron_preview_frame"
              class="bg-gray-200 px-3 py-2 rounded text-sm hover:bg-gray-300 whitespace-nowrap">
        Pré-visualizar
      </button>
    </div>

    <%= turbo_frame_tag "cron_preview_frame" do %>
      <%= render "cron_preview_content", cron: nil, timezone: @schedule.timezone %>
    <% end %>

    <div>
      <%= f.label :run_at, "Data/hora (envio único)", class: "block text-xs text-gray-600" %>
      <%= f.datetime_field :run_at, class: "mt-1 block w-full rounded border-gray-300 text-sm" %>
    </div>
  </fieldset>

  <div class="flex items-center gap-2">
    <%= f.check_box :active %>
    <%= f.label :active, class: "text-sm" %>
  </div>

  <%= f.submit class: "btn-wa" %>
<% end %>
