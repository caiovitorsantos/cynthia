<div class="mt-2 text-sm">
  <% if cron %>
    <p class="text-wa-muted"><%= rough_frequency_in_words(cron.rough_frequency) %></p>
    <ul class="mt-1 list-disc list-inside text-wa-muted">
      <% at = Time.current %>
      <% 3.times do %>
        <% at = cron.next_time(at) %>
        <li><%= l(at.to_t.in_time_zone(timezone), format: :long_date) %></li>
      <% end %>
    </ul>
  <% elsif params.dig(:flow, :cron_expression).present? %>
    <p class="text-red-400"><%= t("flows.cron_preview.invalid") %></p>
  <% else %>
    <p class="text-wa-muted"><%= t("flows.cron_preview.hint") %></p>
  <% end %>
</div>
