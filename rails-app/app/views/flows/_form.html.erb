<% lists = @group.member_lists.sort_by(&:name).map { |list| [ list.name, list.key ] } %>
<% templates = @group.templates.order(:name).map { |template| [ template.name, template.id.to_s ] } %>

<%= form_with model: @flow, url: @flow.persisted? ? group_flow_path(@group, @flow) : group_flows_path(@group), class: "space-y-5 max-w-3xl", data: { controller: "flow-trigger" } do |f| %>
  <% if @flow.errors.any? %>
    <div class="bg-red-950/50 text-red-300 rounded px-4 py-2 text-sm">
      <ul class="list-disc list-inside">
        <% @flow.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid sm:grid-cols-2 gap-3">
    <div>
      <%= f.label :name, t(".name"), class: "block text-sm font-medium" %>
      <%= f.text_field :name, placeholder: t(".name_placeholder"), class: "mt-1 block w-full rounded border-wa-line" %>
    </div>
    <div>
      <%= f.label :trigger, t(".trigger"), class: "block text-sm font-medium" %>
      <%= f.select :trigger, Flow::TRIGGERS.map { |trigger| [ t("flow_triggers.#{trigger}"), trigger ] }, {}, class: "mt-1 block w-full rounded border-wa-line",
            data: { flow_trigger_target: "select", action: "flow-trigger#toggle" } %>
    </div>
  </div>

  <% cron = simple_cron(@flow.cron_expression) %>
  <% mode = if @flow.run_at.present? then "once" elsif @flow.cron_expression.blank? then "weekly" else cron&.dig(:mode) || "custom" end %>
  <fieldset class="border border-wa-line rounded-lg p-4 space-y-3 min-w-0" data-flow-trigger-target="panel" data-trigger="schedule"
            data-controller="schedule" data-action="change->schedule#update input->schedule#update">
    <legend class="text-sm font-medium px-1"><%= t(".when") %></legend>

    <div class="flex flex-wrap gap-3 items-end">
      <div>
        <label class="block text-xs text-wa-muted" for="schedule_mode"><%= t(".repeat") %></label>
        <%= select_tag :schedule_mode, options_for_select(%w[once daily weekly monthly custom].map { |option| [ t(".modes.#{option}"), option ] }, mode),
              id: "schedule_mode", data: { schedule_target: "mode" } %>
      </div>
      <div data-schedule-target="section" data-modes="monthly">
        <label class="block text-xs text-wa-muted" for="schedule_monthday"><%= t(".monthday") %></label>
        <%= number_field_tag :schedule_monthday, cron&.dig(:monthday) || 1, in: 1..31, id: "schedule_monthday", class: "w-20", data: { schedule_target: "monthday" } %>
      </div>
      <div data-schedule-target="section" data-modes="daily weekly monthly">
        <label class="block text-xs text-wa-muted" for="schedule_time"><%= t(".time") %></label>
        <%= time_field_tag :schedule_time, cron&.dig(:time) || "09:00", id: "schedule_time", data: { schedule_target: "time" } %>
      </div>
      <div data-schedule-target="section" data-modes="once">
        <%= f.label :run_at, t(".run_at"), class: "block text-xs text-wa-muted" %>
        <%= f.datetime_field :run_at, data: { schedule_target: "runAt" } %>
      </div>
    </div>

    <div data-schedule-target="section" data-modes="weekly" class="flex flex-wrap gap-2" role="group" aria-label="<%= t(".weekdays") %>">
      <% selected = cron&.dig(:weekdays) || [ Date.current.wday ] %>
      <% t("date.abbr_day_names").each_with_index.to_a.rotate(1).each do |label, day| %>
        <label class="cursor-pointer">
          <input type="checkbox" value="<%= day %>" class="peer sr-only" data-schedule-target="weekday" <%= "checked" if selected.include?(day) %>>
          <span class="inline-block rounded-full border border-wa-line px-3 py-1 text-sm peer-checked:bg-wa-teal peer-checked:text-wa-panel peer-checked:border-wa-teal peer-focus-visible:ring-2 peer-focus-visible:ring-wa-green"><%= label %></span>
        </label>
      <% end %>
    </div>

    <div data-schedule-target="section" data-modes="custom" class="space-y-2">
      <div class="flex flex-wrap gap-2 items-end">
        <div class="flex-1 min-w-40">
          <%= f.label :cron_expression, t(".cron"), class: "block text-xs text-wa-muted" %>
          <%= f.text_field :cron_expression, placeholder: "0 9 * * 1-5", class: "w-full font-mono text-sm", data: { schedule_target: "cron" } %>
        </div>
        <div class="w-full sm:w-56">
          <%= f.label :timezone, t(".timezone"), class: "block text-xs text-wa-muted" %>
          <%= f.text_field :timezone, class: "w-full text-sm" %>
        </div>
        <button type="submit" formaction="<%= cron_preview_group_flows_path(@group) %>" formmethod="get" formnovalidate
                data-turbo-frame="cron_preview_frame" class="bg-wa-raised px-3 py-2 rounded-lg text-sm hover:bg-wa-line whitespace-nowrap cursor-pointer">
          <%= t(".preview") %>
        </button>
      </div>
      <%= turbo_frame_tag "cron_preview_frame" do %>
        <%= render "cron_preview_content", cron: nil, timezone: @flow.timezone %>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="border border-wa-line rounded-lg p-4 space-y-2 min-w-0" data-flow-trigger-target="panel" data-trigger="command">
    <legend class="text-sm font-medium px-1"><%= t(".command") %></legend>
    <%= f.text_field :command, placeholder: "!lista", class: "block w-full sm:w-64 rounded border-wa-line font-mono text-sm" %>
    <p class="text-xs text-wa-muted"><%= t(".command_help_html") %></p>
  </fieldset>

  <fieldset class="min-w-0" data-controller="steps" data-steps-label-value="<%= t(".step_number", n: "%{n}") %>">
    <legend class="text-sm font-medium mb-1"><%= t(".steps") %></legend>
    <p class="text-xs text-wa-muted mb-3"><%= t(".steps_help", seconds: SendGuard::THROTTLE_WINDOW) %></p>

    <% locals = { lists: lists, templates: templates } %>
    <ol class="space-y-3" data-steps-target="list">
      <% (@flow.steps.presence || [ {} ]).each_with_index do |step, index| %>
        <%= render "step", step: step, index: index, **locals %>
      <% end %>
    </ol>
    <template data-steps-target="template"><%= render "step", step: {}, index: "__INDEX__", **locals %></template>

    <button type="button" data-action="steps#add" class="mt-3 text-sm font-medium text-wa-teal border border-dashed border-wa-teal rounded-lg px-4 py-2 w-full hover:bg-wa-bubble/40 cursor-pointer">
      <%= t(".add_step") %>
    </button>
  </fieldset>

  <div class="flex items-center gap-2">
    <%= f.check_box :active %>
    <%= f.label :active, t(".active"), class: "text-sm" %>
  </div>

  <%= f.submit t(".save"), class: "btn-wa" %>
<% end %>
