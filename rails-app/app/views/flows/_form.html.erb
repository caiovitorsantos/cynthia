<% lists = @group.member_lists.sort_by(&:name).map { |list| [ list.name, list.key ] } %>
<% templates = @group.templates.order(:name).map { |template| [ template.name, template.id.to_s ] } %>

<%= form_with model: @flow, url: @flow.persisted? ? group_flow_path(@group, @flow) : group_flows_path(@group), class: "space-y-5 max-w-3xl", data: { controller: "flow-trigger" } do |f| %>
  <% if @flow.errors.any? %>
    <div class="bg-red-100 text-red-800 rounded px-4 py-2 text-sm">
      <ul class="list-disc list-inside">
        <% @flow.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid sm:grid-cols-2 gap-3">
    <div>
      <%= f.label :name, "Nome", class: "block text-sm font-medium" %>
      <%= f.text_field :name, placeholder: "Abrir lista de presença", class: "mt-1 block w-full rounded border-gray-300" %>
    </div>
    <div>
      <%= f.label :trigger, "Gatilho", class: "block text-sm font-medium" %>
      <%= f.select :trigger, Flow::TRIGGERS.invert, {}, class: "mt-1 block w-full rounded border-gray-300",
            data: { flow_trigger_target: "select", action: "flow-trigger#toggle" } %>
    </div>
  </div>

  <% cron = simple_cron(@flow.cron_expression) %>
  <% mode = if @flow.run_at.present? then "once" elsif @flow.cron_expression.blank? then "weekly" else cron&.dig(:mode) || "custom" end %>
  <fieldset class="border rounded-lg p-4 space-y-3 min-w-0" data-flow-trigger-target="panel" data-trigger="schedule"
            data-controller="schedule" data-action="change->schedule#update input->schedule#update">
    <legend class="text-sm font-medium px-1">Quando roda</legend>

    <div class="flex flex-wrap gap-3 items-end">
      <div>
        <label class="block text-xs text-wa-muted" for="schedule_mode">Repetir</label>
        <%= select_tag :schedule_mode, options_for_select([ [ "Uma vez", "once" ], [ "Todo dia", "daily" ], [ "Toda semana", "weekly" ], [ "Todo mês", "monthly" ], [ "Avançado (cron)", "custom" ] ], mode),
              id: "schedule_mode", data: { schedule_target: "mode" } %>
      </div>
      <div data-schedule-target="section" data-modes="monthly">
        <label class="block text-xs text-wa-muted" for="schedule_monthday">Dia do mês</label>
        <%= number_field_tag :schedule_monthday, cron&.dig(:monthday) || 1, in: 1..31, id: "schedule_monthday", class: "w-20", data: { schedule_target: "monthday" } %>
      </div>
      <div data-schedule-target="section" data-modes="daily weekly monthly">
        <label class="block text-xs text-wa-muted" for="schedule_time">Horário</label>
        <%= time_field_tag :schedule_time, cron&.dig(:time) || "09:00", id: "schedule_time", data: { schedule_target: "time" } %>
      </div>
      <div data-schedule-target="section" data-modes="once">
        <%= f.label :run_at, "Data e hora", class: "block text-xs text-wa-muted" %>
        <%= f.datetime_field :run_at, data: { schedule_target: "runAt" } %>
      </div>
    </div>

    <div data-schedule-target="section" data-modes="weekly" class="flex flex-wrap gap-2" role="group" aria-label="Dias da semana">
      <% selected = cron&.dig(:weekdays) || [ Date.current.wday ] %>
      <% FlowsHelper::WEEKDAYS_SHORT.each_with_index.to_a.rotate(1).each do |label, day| %>
        <label class="cursor-pointer">
          <input type="checkbox" value="<%= day %>" class="peer sr-only" data-schedule-target="weekday" <%= "checked" if selected.include?(day) %>>
          <span class="inline-block rounded-full border border-gray-300 px-3 py-1 text-sm peer-checked:bg-wa-teal peer-checked:text-white peer-checked:border-wa-teal peer-focus-visible:ring-2 peer-focus-visible:ring-wa-green"><%= label %></span>
        </label>
      <% end %>
    </div>

    <div data-schedule-target="section" data-modes="custom" class="space-y-2">
      <div class="flex flex-wrap gap-2 items-end">
        <div class="flex-1 min-w-40">
          <%= f.label :cron_expression, "Cron (minuto hora dia mês dia-da-semana)", class: "block text-xs text-wa-muted" %>
          <%= f.text_field :cron_expression, placeholder: "0 9 * * 1-5", class: "w-full font-mono text-sm", data: { schedule_target: "cron" } %>
        </div>
        <div class="w-full sm:w-56">
          <%= f.label :timezone, "Fuso horário", class: "block text-xs text-wa-muted" %>
          <%= f.text_field :timezone, class: "w-full text-sm" %>
        </div>
        <button type="submit" formaction="<%= cron_preview_group_flows_path(@group) %>" formmethod="get" formnovalidate
                data-turbo-frame="cron_preview_frame" class="bg-gray-200 px-3 py-2 rounded-lg text-sm hover:bg-gray-300 whitespace-nowrap cursor-pointer">
          Ver próximos envios
        </button>
      </div>
      <%= turbo_frame_tag "cron_preview_frame" do %>
        <%= render "cron_preview_content", cron: nil, timezone: @flow.timezone %>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="border rounded-lg p-4 space-y-2 min-w-0" data-flow-trigger-target="panel" data-trigger="command">
    <legend class="text-sm font-medium px-1">Comando</legend>
    <%= f.text_field :command, placeholder: "!lista", class: "block w-full sm:w-64 rounded border-gray-300 font-mono text-sm" %>
    <p class="text-xs text-wa-muted">
      Qualquer participante manda o comando no grupo e o fluxo roda. Nos templates e valores dos passos:
      <code class="font-mono">{{remetente}}</code> (quem mandou) e <code class="font-mono">{{argumento}}</code>
      (o texto depois do comando, ex.: "!pix chave@x" → "chave@x").
    </p>
  </fieldset>

  <fieldset class="min-w-0" data-controller="steps">
    <legend class="text-sm font-medium mb-1">Passos (executados em ordem)</legend>
    <p class="text-xs text-wa-muted mb-3">Mensagens seguidas saem com ~<%= SendGuard::THROTTLE_WINDOW %>s de intervalo, para não parecer spam.</p>

    <% locals = { lists: lists, templates: templates } %>
    <ol class="space-y-3" data-steps-target="list">
      <% (@flow.steps.presence || [ {} ]).each_with_index do |step, index| %>
        <%= render "step", step: step, index: index, **locals %>
      <% end %>
    </ol>
    <template data-steps-target="template"><%= render "step", step: {}, index: "__INDEX__", **locals %></template>

    <button type="button" data-action="steps#add" class="mt-3 text-sm font-medium text-wa-teal border border-dashed border-wa-teal rounded-lg px-4 py-2 w-full hover:bg-wa-bubble/40 cursor-pointer">
      + Adicionar passo
    </button>
  </fieldset>

  <div class="flex items-center gap-2">
    <%= f.check_box :active %>
    <%= f.label :active, "Ativo", class: "text-sm" %>
  </div>

  <%= f.submit "Salvar fluxo", class: "btn-wa" %>
<% end %>
