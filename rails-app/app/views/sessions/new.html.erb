<% content_for :title, "Entrar" %>

<div class="max-w-sm mx-auto mt-16 bg-white rounded-lg shadow-sm p-8">
  <h1 class="text-2xl font-semibold text-wa-text mb-6 text-center">Entrar</h1>

  <%= form_with url: login_path, class: "space-y-4" do %>
    <div>
      <%= label_tag :username, "Usuário", class: "block text-sm font-medium" %>
      <%= text_field_tag :username, params[:username], autofocus: true, autocomplete: "username", class: "mt-1 block w-full" %>
    </div>
    <div>
      <%= label_tag :password, "Senha", class: "block text-sm font-medium" %>
      <%= password_field_tag :password, nil, autocomplete: "current-password", class: "mt-1 block w-full" %>
    </div>
    <%= submit_tag "Entrar", class: "btn-wa w-full" %>
  <% end %>
</div>
